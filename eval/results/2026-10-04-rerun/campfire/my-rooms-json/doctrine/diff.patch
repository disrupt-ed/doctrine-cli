+  test "index as json lists the user's rooms with their unread state" do
+    unread, *read = users(:david).memberships.to_a
+    unread.update!(unread_at: Time.current)
+    read.each(&:read)
+
+    get rooms_url(format: :json)
+    assert_response :success
+
+    rooms = response.parsed_body.index_by { |room| room["id"] }
+    assert_equal users(:david).room_ids.sort, rooms.keys.sort
+    assert rooms[unread.room_id]["unread"]
+    assert read.none? { |membership| rooms[membership.room_id]["unread"] }
+  end
+
