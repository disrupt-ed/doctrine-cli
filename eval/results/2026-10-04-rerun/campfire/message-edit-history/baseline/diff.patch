new file mode 100644
index 0000000..0408147
--- /dev/null
+++ b/app/views/messages/edits/index.html.erb
@@ -0,0 +1,26 @@
+<% @page_title = "Edit history" %>
+
+<% content_for :nav do %>
+  <div class="flex-item-justify-start">
+    <%= link_back_to room_at_message_path(@room, @message) %>
+  </div>
+<% end %>
+
+<section class="panel panel--wide flex flex-column">
+  <h1 class="margin-none-block-start">Edit history</h1>
+
+  <h2 class="txt-medium">Current</h2>
+  <div class="message__body-content"><%= @message.body %></div>
+
+  <% if @edits.empty? %>
+    <p>This message hasn’t been edited.</p>
+  <% else %>
+    <h2 class="txt-medium">Previous versions</h2>
+    <% @edits.each do |edit| %>
+      <div class="pad-block">
+        <p class="txt-small margin-none">Replaced by <%= edit.editor.name %> on <%= local_datetime_tag edit.created_at, style: :datetime %></p>
+        <div class="message__body-content"><%= edit.body %></div>
+      </div>
+    <% end %>
+  <% end %>
+</section>
