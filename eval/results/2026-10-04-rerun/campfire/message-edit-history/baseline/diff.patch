diff --git a/app/models/message/editable.rb b/app/models/message/editable.rb
new file mode 100644
index 0000000..b10d8e1
--- /dev/null
+++ b/app/models/message/editable.rb
@@ -0,0 +1,17 @@
+module Message::Editable
+  extend ActiveSupport::Concern
+
+  included do
+    has_many :edits, class_name: "Message::Edit", dependent: :delete_all
+  end
+
+  # Records the text being replaced so admins can see the original.
+  def update_with_history!(attributes)
+    transaction do
+      previous_body = body.to_s
+      update!(attributes)
+
+      edits.create!(body: previous_body) if body.to_s != previous_body
+    end
+  end
+end
