diff --git a/test/controllers/messages/edits_controller_test.rb b/test/controllers/messages/edits_controller_test.rb
new file mode 100644
index 0000000..d30b9ae
--- /dev/null
+++ b/test/controllers/messages/edits_controller_test.rb
@@ -0,0 +1,30 @@
+require "test_helper"
+
+class Messages::EditsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    host! "once.campfire.test"
+  end
+
+  test "admin sees the original text of an edited message" do
+    sign_in :david
+    room = rooms(:watercooler)
+    message = room.messages.where(creator: users(:david)).first
+
+    put room_message_url(room, message), params: { message: { body: "Edited body" } }
+    get room_message_edits_url(room, message)
+
+    assert_response :success
+    assert_select ".message__body-content", text: /Edited body/
+  end
+
+  test "non-admin can't see edit history, even for their own message" do
+    sign_in :jz
+    assert_not users(:jz).administrator?
+
+    room = rooms(:designers)
+    message = room.messages.where(creator: users(:jz)).first
+
+    get room_message_edits_url(room, message)
+    assert_response :forbidden
+  end
+end
diff --git a/test/models/message/editable_test.rb b/test/models/message/editable_test.rb
new file mode 100644
index 0000000..28305ef
--- /dev/null
+++ b/test/models/message/editable_test.rb
@@ -0,0 +1,30 @@
+require "test_helper"
+
+class Message::EditableTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:david)
+    @message = rooms(:watercooler).messages.create!(body: "Original", client_message_id: "edit-test")
+  end
+
+  test "update_with_history! keeps the replaced body" do
+    @message.update_with_history!(body: "Changed")
+
+    assert_equal "Changed", @message.reload.plain_text_body
+    assert_equal 1, @message.edits.count
+    assert_includes @message.edits.last.body, "Original"
+    assert_equal users(:david), @message.edits.last.editor
+  end
+
+  test "update_with_history! keeps every revision" do
+    @message.update_with_history!(body: "Second")
+    @message.update_with_history!(body: "Third")
+
+    assert_equal 2, @message.edits.count
+  end
+
+  test "update_with_history! skips unchanged bodies" do
+    @message.update_with_history!(body: "Original")
+
+    assert_empty @message.edits
+  end
+end
