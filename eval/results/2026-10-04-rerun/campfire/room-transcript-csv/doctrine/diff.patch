diff --git a/app/models/room/transcript.rb b/app/models/room/transcript.rb
new file mode 100644
index 0000000..85fe09a
--- /dev/null
+++ b/app/models/room/transcript.rb
@@ -0,0 +1,30 @@
+require "csv"
+
+class Room::Transcript
+  HEADERS = %w[ sent_at author message ]
+  FORMULA_PREFIXES = [ "=", "+", "-", "@", "\t", "\r" ]
+
+  def initialize(room)
+    @room = room
+  end
+
+  def to_csv
+    CSV.generate do |csv|
+      csv << HEADERS
+
+      @room.messages.with_creator.with_attachment_details.find_each do |message|
+        csv << [ message.created_at.utc.iso8601, safe(message.creator.name), safe(message.plain_text_body) ]
+      end
+    end
+  end
+
+  def filename
+    "#{@room.name.to_s.parameterize.presence || "room"}-transcript.csv"
+  end
+
+  private
+    # Stop spreadsheet apps from running user-written text as a formula.
+    def safe(value)
+      value.start_with?(*FORMULA_PREFIXES) ? "'#{value}" : value
+    end
+end
