new file mode 100644
index 00000000..7e04585c
--- /dev/null
+++ b/internal/api/rate_limiter_test.go
@@ -0,0 +1,66 @@
+// SPDX-FileCopyrightText: Copyright The Miniflux Authors. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package api // import "miniflux.app/v2/internal/api"
+
+import (
+	"testing"
+	"time"
+)
+
+func TestRateLimiterBlocksAfterBurst(t *testing.T) {
+	now := time.Now()
+	limiter := newRateLimiter(3, time.Minute)
+	limiter.now = func() time.Time { return now }
+
+	for i := range 3 {
+		if allowed, _ := limiter.allow("key"); !allowed {
+			t.Fatalf("request %d should be allowed", i+1)
+		}
+	}
+
+	allowed, retryAfter := limiter.allow("key")
+	if allowed {
+		t.Fatal("request over the limit should be rejected")
+	}
+	if retryAfter < 20*time.Second-time.Millisecond || retryAfter > 20*time.Second+time.Millisecond {
+		t.Fatalf("unexpected retry delay: %s", retryAfter)
+	}
+}
+
+func TestRateLimiterIsPerKey(t *testing.T) {
+	limiter := newRateLimiter(1, time.Minute)
+
+	if allowed, _ := limiter.allow("a"); !allowed {
+		t.Fatal("first key should be allowed")
+	}
+	if allowed, _ := limiter.allow("a"); allowed {
+		t.Fatal("first key should be limited")
+	}
+	if allowed, _ := limiter.allow("b"); !allowed {
+		t.Fatal("second key should not be affected by the first")
+	}
+}
+
+func TestRateLimiterRefillsAndCollectsGarbage(t *testing.T) {
+	now := time.Now()
+	limiter := newRateLimiter(2, time.Minute)
+	limiter.now = func() time.Time { return now }
+
+	limiter.allow("key")
+	limiter.allow("key")
+	if allowed, _ := limiter.allow("key"); allowed {
+		t.Fatal("request over the limit should be rejected")
+	}
+
+	now = now.Add(30 * time.Second)
+	if allowed, _ := limiter.allow("key"); !allowed {
+		t.Fatal("a token should have been refilled")
+	}
+
+	now = now.Add(2 * time.Minute)
+	limiter.allow("other")
+	if _, exists := limiter.buckets["key"]; exists {
+		t.Fatal("idle bucket should have been collected")
+	}
+}
