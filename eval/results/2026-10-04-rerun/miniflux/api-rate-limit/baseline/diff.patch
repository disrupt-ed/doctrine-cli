diff --git a/internal/api/rate_limiter.go b/internal/api/rate_limiter.go
new file mode 100644
index 00000000..d6412383
--- /dev/null
+++ b/internal/api/rate_limiter.go
@@ -0,0 +1,76 @@
+// SPDX-FileCopyrightText: Copyright The Miniflux Authors. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package api // import "miniflux.app/v2/internal/api"
+
+import (
+	"sync"
+	"time"
+)
+
+// rateLimiter is a token bucket rate limiter keyed by an arbitrary string.
+// Each key can burst up to "limit" requests and refills at limit/window.
+type rateLimiter struct {
+	mu      sync.Mutex
+	limit   float64
+	window  time.Duration
+	buckets map[string]*bucket
+	nextGC  time.Time
+	now     func() time.Time
+}
+
+type bucket struct {
+	tokens float64
+	last   time.Time
+}
+
+func newRateLimiter(limit int, window time.Duration) *rateLimiter {
+	return &rateLimiter{
+		limit:   float64(limit),
+		window:  window,
+		buckets: make(map[string]*bucket),
+		now:     time.Now,
+	}
+}
+
+// allow consumes a token for the key. When the key is over its limit, it
+// returns false and the duration to wait before a token is available.
+func (l *rateLimiter) allow(key string) (bool, time.Duration) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+
+	now := l.now()
+	l.collectGarbage(now)
+
+	b, ok := l.buckets[key]
+	if !ok {
+		b = &bucket{tokens: l.limit, last: now}
+		l.buckets[key] = b
+	}
+
+	refillRate := l.limit / float64(l.window)
+	b.tokens = min(l.limit, b.tokens+float64(now.Sub(b.last))*refillRate)
+	b.last = now
+
+	if b.tokens < 1 {
+		return false, time.Duration((1 - b.tokens) / refillRate)
+	}
+
+	b.tokens--
+	return true, 0
+}
+
+// collectGarbage drops buckets that have fully refilled, since they are
+// indistinguishable from a new bucket. Must be called with the lock held.
+func (l *rateLimiter) collectGarbage(now time.Time) {
+	if now.Before(l.nextGC) {
+		return
+	}
+	l.nextGC = now.Add(l.window)
+
+	for key, b := range l.buckets {
+		if now.Sub(b.last) >= l.window {
+			delete(l.buckets, key)
+		}
+	}
+}
