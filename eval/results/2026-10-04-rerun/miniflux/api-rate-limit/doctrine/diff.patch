diff --git a/internal/api/ratelimit.go b/internal/api/ratelimit.go
new file mode 100644
index 00000000..21215543
--- /dev/null
+++ b/internal/api/ratelimit.go
@@ -0,0 +1,51 @@
+// SPDX-FileCopyrightText: Copyright The Miniflux Authors. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package api // import "miniflux.app/v2/internal/api"
+
+import (
+	"math"
+	"sync"
+	"time"
+)
+
+// rateLimiter is an in-memory token bucket limiter keyed by API key.
+// Each bucket holds up to perMinute tokens and refills continuously.
+// Only authenticated API keys are tracked, so the map is bounded by the
+// number of valid keys.
+type rateLimiter struct {
+	mu      sync.Mutex
+	buckets map[string]*bucket
+}
+
+type bucket struct {
+	tokens float64
+	last   time.Time
+}
+
+func newRateLimiter() *rateLimiter {
+	return &rateLimiter{buckets: make(map[string]*bucket)}
+}
+
+// allow consumes one token for the key. When the bucket is empty it returns
+// false and the number of seconds to wait before the next token is available.
+func (l *rateLimiter) allow(key string, perMinute int, now time.Time) (bool, int) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+
+	capacity := float64(perMinute)
+	b, ok := l.buckets[key]
+	if !ok {
+		b = &bucket{tokens: capacity, last: now}
+		l.buckets[key] = b
+	}
+
+	b.tokens = min(capacity, b.tokens+now.Sub(b.last).Seconds()*capacity/60)
+	b.last = now
+
+	if b.tokens < 1 {
+		return false, int(math.Ceil((1 - b.tokens) * 60 / capacity))
+	}
+	b.tokens--
+	return true, 0
+}
diff --git a/internal/api/ratelimit_test.go b/internal/api/ratelimit_test.go
new file mode 100644
index 00000000..24d79ef2
--- /dev/null
+++ b/internal/api/ratelimit_test.go
@@ -0,0 +1,40 @@
+// SPDX-FileCopyrightText: Copyright The Miniflux Authors. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package api // import "miniflux.app/v2/internal/api"
+
+import (
+	"testing"
+	"time"
+)
+
+func TestRateLimiter(t *testing.T) {
+	const perMinute = 60 // 1 token per second, burst of 60
+	l := newRateLimiter()
+	now := time.Now()
+
+	for i := range perMinute {
+		if ok, _ := l.allow("a", perMinute, now); !ok {
+			t.Fatalf("request %d should be allowed within the burst", i)
+		}
+	}
+
+	ok, retryAfter := l.allow("a", perMinute, now)
+	if ok {
+		t.Fatal("request over the limit should be rejected")
+	}
+	if retryAfter != 1 {
+		t.Fatalf("unexpected retry after, got %d instead of 1", retryAfter)
+	}
+
+	if ok, _ := l.allow("b", perMinute, now); !ok {
+		t.Fatal("another key must have its own bucket")
+	}
+
+	if ok, _ := l.allow("a", perMinute, now.Add(time.Second)); !ok {
+		t.Fatal("a token should have been refilled after one second")
+	}
+	if ok, _ := l.allow("a", perMinute, now.Add(time.Second)); ok {
+		t.Fatal("only one token should have been refilled")
+	}
+}
