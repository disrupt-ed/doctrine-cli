+// ArchiveEntriesOverFeedLimit deletes the oldest entries of feeds holding more than maxPerFeed entries
+// and records tombstones so they are not re-ingested. Starred and shared entries are never deleted.
+func (s *Storage) ArchiveEntriesOverFeedLimit(maxPerFeed, limit int) (int64, error) {
+	if maxPerFeed <= 0 || limit <= 0 {
+		return 0, nil
+	}
+
+	query := `
+		WITH ranked AS (
+			SELECT id, row_number() OVER (PARTITION BY feed_id ORDER BY published_at DESC, id DESC) AS position
+			FROM entries
+			WHERE feed_id IN (SELECT feed_id FROM entries GROUP BY feed_id HAVING count(*) > $1)
+		), to_delete AS (
+			SELECT e.id
+			FROM entries e
+			JOIN ranked r ON r.id = e.id
+			WHERE
+				r.position > $1 AND
+				e.starred is false AND
+				e.share_code=''
+			ORDER BY e.published_at ASC
+			FOR UPDATE OF e SKIP LOCKED
+			LIMIT $2
+		), deleted AS (
+			DELETE FROM entries
+			USING to_delete
+			WHERE entries.id = to_delete.id
+			RETURNING entries.feed_id, entries.hash
+		)
+		INSERT INTO entry_tombstones (feed_id, hash)
+		SELECT feed_id, hash FROM deleted WHERE hash <> ''
+		ON CONFLICT (feed_id, hash) DO NOTHING
+	`
+
+	result, err := s.db.Exec(query, maxPerFeed, limit)
+	if err != nil {
+		return 0, fmt.Errorf(`store: unable to archive entries over the feed limit: %v`, err)
+	}
+
+	count, err := result.RowsAffected()
+	if err != nil {
+		return 0, fmt.Errorf(`store: unable to get the number of rows affected: %v`, err)
+	}
+
+	return count, nil
+}
