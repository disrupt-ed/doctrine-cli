 }
 
+// IsValidWebhookURL reports whether the url is absolute, has a host and starts with an HTTP or HTTPS scheme.
+func IsValidWebhookURL(inputURL string) bool {
+	if !hasHTTPPrefix(inputURL) {
+		return false
+	}
+	parsedURL, err := url.Parse(inputURL)
+	if err != nil {
+		return false
+	}
+	return parsedURL.IsAbs() && parsedURL.Host != ""
+}
