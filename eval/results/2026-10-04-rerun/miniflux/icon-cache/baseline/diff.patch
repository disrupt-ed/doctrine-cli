diff --git a/internal/storage/icon_cache.go b/internal/storage/icon_cache.go
new file mode 100644
index 00000000..aef2cee5
--- /dev/null
+++ b/internal/storage/icon_cache.go
@@ -0,0 +1,89 @@
+// SPDX-FileCopyrightText: Copyright The Miniflux Authors. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package storage // import "miniflux.app/v2/internal/storage"
+
+import (
+	"sync"
+	"time"
+
+	"miniflux.app/v2/internal/model"
+)
+
+const (
+	iconCacheTTL      = 1 * time.Hour
+	iconCacheMaxBytes = 16 * 1024 * 1024
+)
+
+type iconCacheEntry struct {
+	icon      *model.Icon
+	expiresAt time.Time
+}
+
+// iconCache is an in-memory cache of icons keyed by external ID.
+//
+// An icon row is immutable once created (its content is addressed by hash),
+// so entries never need invalidation except when the row is deleted, which
+// only happens in CleanupOrphanIcons. Cached icons must be treated as read-only.
+type iconCache struct {
+	mu      sync.Mutex
+	entries map[string]iconCacheEntry
+	size    int
+}
+
+func newIconCache() *iconCache {
+	return &iconCache{entries: make(map[string]iconCacheEntry)}
+}
+
+func (c *iconCache) get(externalID string) (*model.Icon, bool) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	entry, ok := c.entries[externalID]
+	if !ok {
+		return nil, false
+	}
+	if time.Now().After(entry.expiresAt) {
+		c.remove(externalID)
+		return nil, false
+	}
+	return entry.icon, true
+}
+
+func (c *iconCache) set(icon *model.Icon) {
+	cost := len(icon.Content)
+	if cost > iconCacheMaxBytes {
+		return
+	}
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	c.remove(icon.ExternalID)
+	// Evict arbitrary entries until the new icon fits.
+	for key := range c.entries {
+		if c.size+cost <= iconCacheMaxBytes {
+			break
+		}
+		c.remove(key)
+	}
+
+	c.entries[icon.ExternalID] = iconCacheEntry{icon: icon, expiresAt: time.Now().Add(iconCacheTTL)}
+	c.size += cost
+}
+
+func (c *iconCache) clear() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	c.entries = make(map[string]iconCacheEntry)
+	c.size = 0
+}
+
+// remove must be called with c.mu held.
+func (c *iconCache) remove(externalID string) {
+	if entry, ok := c.entries[externalID]; ok {
+		c.size -= len(entry.icon.Content)
+		delete(c.entries, externalID)
+	}
+}
