@@ -0,0 +1,33 @@
+require "test_helper"
+
+class Push::UnreadDigestTest < ActiveSupport::TestCase
+  setup do
+    stub_web_push_dns_resolution
+    Membership.update_all(unread_at: nil)
+  end
+
+  test "notifies users with unread rooms and a push subscription" do
+    memberships(:kevin_designers).update!(unread_at: Time.current)
+    expected = users(:kevin).push_subscriptions.count
+
+    WebPush.expects(:payload_send).times(expected)
+    Push::UnreadDigest.new.push
+    wait_for_delivery(expected)
+  end
+
+  test "skips invisible rooms and deactivated users" do
+    memberships(:david_designers).update!(unread_at: Time.current, involvement: "invisible")
+    memberships(:kevin_designers).update!(unread_at: Time.current)
+    users(:kevin).update_column(:status, User.statuses[:deactivated])
+
+    WebPush.expects(:payload_send).never
+    Push::UnreadDigest.new.push
+  end
+
+  private
+    def wait_for_delivery(count)
+      pool = Rails.configuration.x.web_push_pool.delivery_pool
+      start = Time.now
+      sleep 0.02 while pool.completed_task_count < count && Time.now - start < 1
+    end
+end
