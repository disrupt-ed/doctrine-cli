+++ b/app/models/push/unread_digest.rb
@@ -0,0 +1,23 @@
+class Push::UnreadDigest
+  def push
+    users_with_unread_rooms.find_each do |user|
+      count = user.memberships.visible.unread.count
+      next if count.zero?
+
+      Rails.configuration.x.web_push_pool.queue(payload_for(count), user.push_subscriptions)
+    end
+  end
+
+  private
+    def users_with_unread_rooms
+      User.active.where(id: Push::Subscription.select(:user_id)).where(id: Membership.visible.unread.select(:user_id))
+    end
+
+    def payload_for(count)
+      {
+        title: "Unread rooms",
+        body: "You have #{count} #{'room'.pluralize(count)} with unread messages",
+        path: Rails.application.routes.url_helpers.root_path
+      }
+    end
+end
