@@ -0,0 +1,24 @@
+class Push::UnreadReminder
+  def deliver
+    unread_counts.each do |user_id, count|
+      payload = build_payload(count)
+      Rails.configuration.x.web_push_pool.queue(payload, Push::Subscription.where(user_id: user_id))
+    end
+  end
+
+  private
+    def unread_counts
+      Membership.visible.unread
+        .joins(:user).merge(User.active)
+        .where(user_id: Push::Subscription.select(:user_id))
+        .group(:user_id).count
+    end
+
+    def build_payload(count)
+      {
+        title: "Unread rooms",
+        body: "You have #{count} #{"room".pluralize(count)} with unread messages",
+        path: Rails.application.routes.url_helpers.root_path
+      }
+    end
+end
