+require "test_helper"
+
+class Push::UnreadReminderTest < ActiveSupport::TestCase
+  setup do
+    stub_web_push_dns_resolution
+    Membership.update_all(unread_at: nil)
+  end
+
+  test "notifies subscribed users with unread rooms" do
+    memberships(:kevin_designers).update!(unread_at: Time.current)
+
+    expected = users(:kevin).push_subscriptions.count
+    assert_operator expected, :>, 0
+
+    WebPush.expects(:payload_send).times(expected)
+    Push::UnreadReminder.new.deliver
+    wait_for_deliveries(expected)
+  end
+
+  test "does not notify users without unread rooms" do
+    WebPush.expects(:payload_send).never
+    Push::UnreadReminder.new.deliver
+    sleep 0.05
+  end
+
+  test "does not notify users with unread rooms but no subscriptions" do
+    user = users(:kevin)
+    user.push_subscriptions.delete_all
+    memberships(:kevin_designers).update!(unread_at: Time.current)
+
+    WebPush.expects(:payload_send).never
+    Push::UnreadReminder.new.deliver
+    sleep 0.05
+  end
+
+  test "does not notify for invisible memberships" do
+    memberships(:kevin_designers).update!(unread_at: Time.current, involvement: :invisible)
+
+    WebPush.expects(:payload_send).never
+    Push::UnreadReminder.new.deliver
+    sleep 0.05
+  end
+
+  private
+    def wait_for_deliveries(count)
+      pool = Rails.configuration.x.web_push_pool.delivery_pool
+      start = Time.now
+      while pool.completed_task_count < count
+        raise "Timeout waiting for pool tasks to complete" if Time.now - start > 0.5
+        sleep 0.02
+      end
+    end
+end
