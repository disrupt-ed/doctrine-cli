diff --git a/test/controllers/messages/edits_controller_test.rb b/test/controllers/messages/edits_controller_test.rb
new file mode 100644
index 0000000..e377c5e
--- /dev/null
+++ b/test/controllers/messages/edits_controller_test.rb
@@ -0,0 +1,30 @@
+require "test_helper"
+
+class Messages::EditsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    host! "once.campfire.test"
+
+    @message = rooms(:designers).messages.where(creator: users(:jz)).first
+    @message.update!(body: "Original")
+    @message.update!(body: "Edited")
+  end
+
+  test "admin sees the original text" do
+    sign_in :david
+    assert users(:david).administrator?
+
+    get message_edits_url(@message)
+
+    assert_response :success
+    assert_select ".message__body-content", text: /Original/
+  end
+
+  test "non-admin can't see edit history, even for their own message" do
+    sign_in :jz
+    assert_not users(:jz).administrator?
+
+    get message_edits_url(@message)
+
+    assert_response :forbidden
+  end
+end
diff --git a/test/models/message_test.rb b/test/models/message_test.rb
index 3cd12c1..05a3350 100644
--- a/test/models/message_test.rb
+++ b/test/models/message_test.rb
@@ -27,6 +27,26 @@ class MessageTest < ActiveSupport::TestCase
     assert_equal [], message_mentioning_a_non_member.mentionees
   end
 
+  test "changing the body records the previous body as an edit" do
+    message = create_new_message_in rooms(:designers)
+
+    assert_difference -> { message.edits.count }, 1 do
+      message.update!(body: "Changed")
+    end
+
+    assert_equal "Hello", message.edits.last.body.to_plain_text
+    assert_equal "Changed", message.reload.plain_text_body
+  end
+
+  test "saving without changing the body doesn't record an edit" do
+    message = create_new_message_in rooms(:designers)
+
+    assert_no_difference -> { Message::Edit.count } do
+      message.update!(body: "Hello")
+      message.touch
+    end
+  end
+
   private
     def create_new_message_in(room)
       room.messages.create!(creator: users(:jason), body: "Hello", client_message_id: "123")
