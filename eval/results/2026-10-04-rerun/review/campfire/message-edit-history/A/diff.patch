diff --git a/app/models/message/editable.rb b/app/models/message/editable.rb
new file mode 100644
index 0000000..f00e9d4
--- /dev/null
+++ b/app/models/message/editable.rb
@@ -0,0 +1,14 @@
+module Message::Editable
+  extend ActiveSupport::Concern
+
+  included do
+    has_many :edits, dependent: :destroy
+
+    before_update :record_edit, if: -> { body.body_changed? }
+  end
+
+  private
+    def record_edit
+      edits.create!(body: body.body_was)
+    end
+end
