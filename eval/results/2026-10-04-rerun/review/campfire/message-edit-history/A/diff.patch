diff --git a/app/views/messages/edits/index.html.erb b/app/views/messages/edits/index.html.erb
new file mode 100644
index 0000000..13fd57c
--- /dev/null
+++ b/app/views/messages/edits/index.html.erb
@@ -0,0 +1,16 @@
+<% @page_title = "Edit history" %>
+
+<div class="pad" data-controller="local-time">
+  <h1 class="txt-large">Edit history</h1>
+
+  <% if @edits.any? %>
+    <% @edits.each do |edit| %>
+      <section class="border-bottom pad-block">
+        <p class="txt-small txt-subtle">Replaced <%= local_datetime_tag edit.created_at, style: :datetime %></p>
+        <div class="message__body-content"><%= edit.body %></div>
+      </section>
+    <% end %>
+  <% else %>
+    <p>This message has never been edited.</p>
+  <% end %>
+</div>
