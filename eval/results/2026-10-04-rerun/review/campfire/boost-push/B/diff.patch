diff --git a/app/models/boost/pusher.rb b/app/models/boost/pusher.rb
new file mode 100644
index 0000000..26cfee0
--- /dev/null
+++ b/app/models/boost/pusher.rb
@@ -0,0 +1,33 @@
+class Boost::Pusher
+  attr_reader :boost
+
+  delegate :message, :booster, to: :boost
+  delegate :room, to: :message
+
+  def initialize(boost:)
+    @boost = boost
+  end
+
+  def push
+    return if booster == message.creator
+
+    build_payload.tap do |payload|
+      Rails.configuration.x.web_push_pool.queue(payload, relevant_subscriptions)
+    end
+  end
+
+  private
+    def build_payload
+      {
+        title: room.direct? ? booster.name : room.name,
+        body: "#{booster.name} boosted: #{message.plain_text_body.truncate(100)}",
+        path: Rails.application.routes.url_helpers.room_path(room)
+      }
+    end
+
+    def relevant_subscriptions
+      Push::Subscription
+        .joins(user: :memberships)
+        .merge(Membership.visible.disconnected.where(room: room, user: message.creator))
+    end
+end
