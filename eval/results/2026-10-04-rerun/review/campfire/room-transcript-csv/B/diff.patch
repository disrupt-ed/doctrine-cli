diff --git a/app/models/room/transcript.rb b/app/models/room/transcript.rb
new file mode 100644
index 0000000..0a05217
--- /dev/null
+++ b/app/models/room/transcript.rb
@@ -0,0 +1,29 @@
+# Renders a room's messages as CSV. Written by hand rather than with the csv gem,
+# which is no longer a default gem as of Ruby 3.4.
+class Room::Transcript
+  HEADERS = %w[ id created_at author message ]
+  FORMULA_PREFIXES = %w[ = + - @ ] + [ "\t", "\r" ]
+
+  def initialize(room)
+    @room = room
+  end
+
+  def to_csv
+    rows = [ HEADERS ]
+
+    @room.messages.with_creator.with_rich_text_body_and_embeds.with_attached_attachment.find_each do |message|
+      rows << [ message.id, message.created_at.utc.iso8601, message.creator.name, message.plain_text_body ]
+    end
+
+    rows.map { |row| row.map { |cell| escape(cell) }.join(",") }.join("\r\n") + "\r\n"
+  end
+
+  private
+    # Spreadsheets run cells that start with these characters as formulas, and
+    # message bodies are user-supplied, so neutralize them with a leading quote.
+    def escape(value)
+      value = value.to_s
+      value = "'#{value}" if value.start_with?(*FORMULA_PREFIXES)
+      value.match?(/[",\r\n]/) ? %("#{value.gsub('"', '""')}") : value
+    end
+end
