diff --git a/test/controllers/rooms/transcripts_controller_test.rb b/test/controllers/rooms/transcripts_controller_test.rb
new file mode 100644
index 0000000..3116e72
--- /dev/null
+++ b/test/controllers/rooms/transcripts_controller_test.rb
@@ -0,0 +1,40 @@
+require "test_helper"
+
+class Rooms::TranscriptsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :david
+  end
+
+  test "downloads the room's messages as CSV" do
+    room = rooms(:hq)
+    room.messages.create!(creator: users(:jason), body: "Hello, \"world\"", client_message_id: "csv-1")
+
+    get room_transcript_url(room, format: :csv)
+
+    assert_response :success
+    assert_equal "text/csv; charset=utf-8", response.content_type
+    assert_match "attachment", response.headers["Content-Disposition"]
+
+    lines = response.body.split("\r\n")
+    assert_equal "id,created_at,author,message", lines.first
+    assert_includes response.body, %("Hello, ""world""")
+  end
+
+  test "neutralizes spreadsheet formulas" do
+    room = rooms(:hq)
+    room.messages.create!(creator: users(:jason), body: "=HYPERLINK(\"http://evil\")", client_message_id: "csv-2")
+
+    get room_transcript_url(room, format: :csv)
+
+    assert_includes response.body, %("'=HYPERLINK(""http://evil"")")
+  end
+
+  test "non-members can't download" do
+    room = rooms(:hq)
+    room.memberships.where(user: users(:david)).destroy_all
+
+    get room_transcript_url(room, format: :csv)
+
+    assert_response :not_found
+  end
+end
