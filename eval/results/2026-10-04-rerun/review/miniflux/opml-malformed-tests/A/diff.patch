+func TestParseMalformedOPML(t *testing.T) {
+	testCases := []struct {
+		name string
+		data string
+	}{
+		{"empty input", ``},
+		{"whitespace only", " \n\t "},
+		{"wrong root element", `<?xml version="1.0"?><rss version="2.0"><channel><title>Not OPML</title></channel></rss>`},
+		{"truncated before body", `<?xml version="1.0"?><opml version="2.0"><head><title>x</title>`},
+		{"truncated inside attribute", `<opml version="2.0"><body><outline type="rss" title="Feed" xmlUrl="http://example.org/feed`},
+		{"invalid miniflux boolean", `<opml version="2.0" xmlns:miniflux="https://miniflux.app/opml"><body><outline type="rss" title="Feed" xmlUrl="http://example.org/feed" miniflux:crawler="maybe"/></body></opml>`},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			subscriptions, err := parse(bytes.NewBufferString(tc.data))
+			if err == nil {
+				t.Fatalf("Parse should generate an error, got %d subscriptions", len(subscriptions))
+			}
+			if subscriptions != nil {
+				t.Errorf("Subscriptions should be nil on error, got %v", subscriptions)
+			}
+		})
+	}
+}
+
+func TestParseOpmlSkipsOutlinesWithoutFeedURL(t *testing.T) {
+	data := `<?xml version="1.0"?>
+	<opml version="2.0">
+		<body>
+			<outline text="No URL" title="No URL" type="rss"></outline>
+			<outline type="rss" title="Feed 1" xmlUrl="http://example.org/feed1"></outline>
+		</body>
+	</opml>`
+
+	subscriptions, err := parse(bytes.NewBufferString(data))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if len(subscriptions) != 1 {
+		t.Fatalf("Wrong number of subscriptions: %d instead of %d", len(subscriptions), 1)
+	}
+
+	if subscriptions[0].FeedURL != "http://example.org/feed1" {
+		t.Errorf("Unexpected feed URL: %q", subscriptions[0].FeedURL)
+	}
+}
