diff --git a/internal/storage/icon_cache_test.go b/internal/storage/icon_cache_test.go
new file mode 100644
index 00000000..29ea8e82
--- /dev/null
+++ b/internal/storage/icon_cache_test.go
@@ -0,0 +1,39 @@
+// SPDX-FileCopyrightText: Copyright The Miniflux Authors. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package storage // import "miniflux.app/v2/internal/storage"
+
+import (
+	"strconv"
+	"testing"
+
+	"miniflux.app/v2/internal/model"
+)
+
+func TestIconCache(t *testing.T) {
+	var c iconCache
+	if c.get("a") != nil {
+		t.Fatal("zero value cache should be empty")
+	}
+
+	icon := &model.Icon{ExternalID: "a"}
+	c.set(icon)
+	if c.get("a") != icon {
+		t.Fatal("expected cached icon")
+	}
+
+	c.clear()
+	if c.get("a") != nil {
+		t.Fatal("expected cache to be cleared")
+	}
+}
+
+func TestIconCacheIsBounded(t *testing.T) {
+	var c iconCache
+	for i := 0; i < maxCachedIcons*2; i++ {
+		c.set(&model.Icon{ExternalID: strconv.Itoa(i)})
+	}
+	if len(c.icons) != maxCachedIcons {
+		t.Fatalf("expected %d entries, got %d", maxCachedIcons, len(c.icons))
+	}
+}
