 	"miniflux.app/v2/internal/crypto"
 	"miniflux.app/v2/internal/model"
 )
 
+const maxCachedIcons = 512
+
+// iconCache keeps recently served icons in memory, keyed by external ID.
+// An external ID always maps to the same content (icons are deduplicated by
+// hash and never updated), so entries only go stale when the icon is deleted.
+// The zero value is ready to use.
+type iconCache struct {
+	mu    sync.RWMutex
+	icons map[string]*model.Icon
+}
+
+func (c *iconCache) get(externalID string) *model.Icon {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	return c.icons[externalID]
+}
+
+func (c *iconCache) set(icon *model.Icon) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.icons == nil {
+		c.icons = make(map[string]*model.Icon)
+	}
+	if _, exists := c.icons[icon.ExternalID]; !exists && len(c.icons) >= maxCachedIcons {
+		for k := range c.icons { // Evict an arbitrary entry.
+			delete(c.icons, k)
+			break
+		}
+	}
+	c.icons[icon.ExternalID] = icon
+}
+
+func (c *iconCache) clear() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.icons = nil
+}
