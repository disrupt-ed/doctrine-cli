index 00000000..940ac5e7
--- /dev/null
+++ b/internal/http/server/middleware_test.go
@@ -0,0 +1,42 @@
+// SPDX-FileCopyrightText: Copyright The Miniflux Authors. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package server // import "miniflux.app/v2/internal/http/server"
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"miniflux.app/v2/internal/http/request"
+)
+
+func TestMiddlewareSetsUniqueRequestID(t *testing.T) {
+	var seen string
+	handler := middleware(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		seen = request.RequestID(r)
+		w.WriteHeader(http.StatusTeapot)
+	}))
+
+	ids := map[string]bool{}
+	for range 2 {
+		rec := httptest.NewRecorder()
+		handler.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", nil))
+
+		header := rec.Header().Get("X-Request-Id")
+		if header == "" {
+			t.Fatal("expected X-Request-Id response header")
+		}
+		if header != seen {
+			t.Errorf("header %q does not match context request ID %q", header, seen)
+		}
+		if rec.Code != http.StatusTeapot {
+			t.Errorf("status = %d, want %d", rec.Code, http.StatusTeapot)
+		}
+		ids[header] = true
+	}
+
+	if len(ids) != 2 {
+		t.Error("expected a different request ID for each request")
+	}
+}
