+
+// ExportStarredContext exports all starred entries.
+func (c *Client) ExportStarredContext(ctx context.Context) (*EntryResultSet, error) {
+	body, err := c.request.Get(ctx, "/v1/export/starred")
+	if err != nil {
+		return nil, err
+	}
+	defer body.Close()
+
+	var result EntryResultSet
+	if err := json.NewDecoder(body).Decode(&result); err != nil {
+		return nil, fmt.Errorf("miniflux: response error (%v)", err)
+	}
+
+	return &result, nil
+}
