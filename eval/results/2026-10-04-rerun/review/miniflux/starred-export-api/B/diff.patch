+func TestExportStarredEndpoint(t *testing.T) {
+	t.Parallel()
+
+	testConfig := newIntegrationTestConfig()
+	if !testConfig.isConfigured() {
+		t.Skip(skipIntegrationTestsMessage)
+	}
+
+	adminClient := miniflux.NewClient(testConfig.testBaseURL, testConfig.testAdminUsername, testConfig.testAdminPassword)
+
+	regularTestUser, err := adminClient.CreateUser(testConfig.genRandomUsername(), testConfig.testRegularPassword, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer adminClient.DeleteUser(regularTestUser.ID)
+
+	regularUserClient := miniflux.NewClient(testConfig.testBaseURL, regularTestUser.Username, testConfig.testRegularPassword)
+
+	result, err := regularUserClient.ExportStarred()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.Total != 0 || len(result.Entries) != 0 {
+		t.Fatalf(`Expected no starred entries for a new user, got %d`, len(result.Entries))
+	}
+
+	if _, err := regularUserClient.CreateFeed(&miniflux.FeedCreationRequest{FeedURL: testConfig.testFeedURL}); err != nil {
+		t.Fatal(err)
+	}
+
+	entries, err := regularUserClient.Entries(&miniflux.Filter{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(entries.Entries) < 2 {
+		t.Fatalf(`Expected at least 2 entries, got %d`, len(entries.Entries))
+	}
+
+	starredID := entries.Entries[0].ID
+	if err := regularUserClient.ToggleStarred(starredID); err != nil {
+		t.Fatal(err)
+	}
+
+	result, err = regularUserClient.ExportStarred()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.Total != 1 || len(result.Entries) != 1 {
+		t.Fatalf(`Expected 1 starred entry, got total=%d entries=%d`, result.Total, len(result.Entries))
+	}
+	if result.Entries[0].ID != starredID {
+		t.Fatalf(`Expected starred entry %d, got %d`, starredID, result.Entries[0].ID)
+	}
+}
