+// exportStarredEntriesHandler returns every starred entry of the user as JSON.
+// No limit is set on the query builder, so the result is not paginated.
+func (h *handler) exportStarredEntriesHandler(w http.ResponseWriter, r *http.Request) {
+	entries, err := h.store.NewEntryQueryBuilder(request.UserID(r)).
+		WithStarred(true).
+		WithSorting("published_at", "DESC").
+		WithEnclosures().
+		GetEntries()
+	if err != nil {
+		response.JSONServerError(w, r, err)
+		return
+	}
+
+	for i := range entries {
+		entries[i].Content = mediaproxy.RewriteDocumentWithAbsoluteProxyURL(entries[i].Content)
+		entries[i].Enclosures.ProxifyEnclosureURL(config.Opts.MediaProxyMode(), config.Opts.MediaProxyResourceTypes())
+	}
+
+	response.JSON(w, r, &entriesResponse{Total: len(entries), Entries: entries})
+}
