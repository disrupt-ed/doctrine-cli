diff --git a/internal/integration/gotify/gotify.go b/internal/integration/gotify/gotify.go
new file mode 100644
index 00000000..e62be7c2
--- /dev/null
+++ b/internal/integration/gotify/gotify.go
@@ -0,0 +1,105 @@
+// SPDX-FileCopyrightText: Copyright The Miniflux Authors. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package gotify // import "miniflux.app/v2/internal/integration/gotify"
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"log/slog"
+	"net/http"
+	"strings"
+	"time"
+
+	"miniflux.app/v2/internal/config"
+	"miniflux.app/v2/internal/http/client"
+	"miniflux.app/v2/internal/model"
+	"miniflux.app/v2/internal/version"
+)
+
+const defaultClientTimeout = 10 * time.Second
+
+type Client struct {
+	gotifyURL, gotifyToken string
+	gotifyPriority         int
+}
+
+// See https://gotify.net/docs/pushmsg
+type message struct {
+	Title    string         `json:"title"`
+	Message  string         `json:"message"`
+	Priority int            `json:"priority"`
+	Extras   map[string]any `json:"extras,omitempty"`
+}
+
+func NewClient(gotifyURL, gotifyToken string, gotifyPriority int) *Client {
+	return &Client{
+		gotifyURL:      strings.TrimRight(gotifyURL, "/"),
+		gotifyToken:    gotifyToken,
+		gotifyPriority: max(0, min(gotifyPriority, 10)),
+	}
+}
+
+func (c *Client) SendMessages(feed *model.Feed, entries model.Entries) error {
+	if c.gotifyURL == "" || c.gotifyToken == "" {
+		return errors.New("gotify: URL and application token are required")
+	}
+
+	for _, entry := range entries {
+		msg := &message{
+			Title:    feed.Title,
+			Message:  entry.Title,
+			Priority: c.gotifyPriority,
+			Extras: map[string]any{
+				// See https://gotify.net/docs/msgextras#clientnotification
+				"client::notification": map[string]any{
+					"click": map[string]string{"url": entry.URL},
+				},
+			},
+		}
+
+		slog.Debug("Sending Gotify message",
+			slog.String("url", c.gotifyURL),
+			slog.Int("priority", msg.Priority),
+			slog.String("message", msg.Message),
+			slog.String("entry_url", entry.URL),
+		)
+
+		if err := c.makeRequest(msg); err != nil {
+			return err
+		}
+	}
+
+	return nil
+}
+
+func (c *Client) makeRequest(payload *message) error {
+	requestBody, err := json.Marshal(payload)
+	if err != nil {
+		return fmt.Errorf("gotify: unable to encode request body: %w", err)
+	}
+
+	request, err := http.NewRequest(http.MethodPost, c.gotifyURL+"/message", bytes.NewReader(requestBody))
+	if err != nil {
+		return fmt.Errorf("gotify: unable to create request: %w", err)
+	}
+
+	request.Header.Set("Content-Type", "application/json")
+	request.Header.Set("User-Agent", "Miniflux/"+version.Version)
+	request.Header.Set("X-Gotify-Key", c.gotifyToken)
+
+	httpClient := client.NewClientWithOptions(client.Options{Timeout: defaultClientTimeout, BlockPrivateNetworks: !config.Opts.IntegrationAllowPrivateNetworks()})
+	response, err := httpClient.Do(request)
+	if err != nil {
+		return fmt.Errorf("gotify: unable to send request: %w", err)
+	}
+	defer response.Body.Close()
+
+	if response.StatusCode >= http.StatusBadRequest {
+		return fmt.Errorf("gotify: incorrect response status code %d for url %s", response.StatusCode, c.gotifyURL)
+	}
+
+	return nil
+}
