diff --git a/internal/ui/form/integration_test.go b/internal/ui/form/integration_test.go
index e8d7f59b..e7598d29 100644
--- a/internal/ui/form/integration_test.go
+++ b/internal/ui/form/integration_test.go
@@ -7,6 +7,35 @@ import (
 	"testing"
 )
 
+func TestValidateWebhook(t *testing.T) {
+	scenarios := []struct {
+		name        string
+		form        IntegrationForm
+		expectError bool
+	}{
+		{name: "disabled with invalid URL", form: IntegrationForm{WebhookURL: "nope"}},
+		{name: "enabled with empty URL", form: IntegrationForm{WebhookEnabled: true}},
+		{name: "https URL", form: IntegrationForm{WebhookEnabled: true, WebhookURL: "https://example.org/hook?a=b"}},
+		{name: "http URL with port", form: IntegrationForm{WebhookEnabled: true, WebhookURL: "http://localhost:8080/hook"}},
+		{name: "no scheme", form: IntegrationForm{WebhookEnabled: true, WebhookURL: "example.org/hook"}, expectError: true},
+		{name: "unsupported scheme", form: IntegrationForm{WebhookEnabled: true, WebhookURL: "ftp://example.org/hook"}, expectError: true},
+		{name: "no host", form: IntegrationForm{WebhookEnabled: true, WebhookURL: "http:///hook"}, expectError: true},
+		{name: "opaque URL", form: IntegrationForm{WebhookEnabled: true, WebhookURL: "http:example.org"}, expectError: true},
+	}
+
+	for _, scenario := range scenarios {
+		t.Run(scenario.name, func(t *testing.T) {
+			validationErr := scenario.form.ValidateWebhook()
+			if scenario.expectError && validationErr == nil {
+				t.Fatal("expected a validation error")
+			}
+			if !scenario.expectError && validationErr != nil {
+				t.Fatalf("unexpected validation error: %v", validationErr)
+			}
+		})
+	}
+}
