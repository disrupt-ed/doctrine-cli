+// ValidateWebhook ensures the webhook URL, when the integration is enabled, is an absolute HTTP or HTTPS URL with a host.
+// An empty URL is allowed: the handler disables the integration in that case.
+func (i IntegrationForm) ValidateWebhook() *locale.LocalizedError {
+	if !i.WebhookEnabled || i.WebhookURL == "" {
+		return nil
+	}
+	if !urllib.IsAbsoluteURL(i.WebhookURL) {
+		return locale.NewLocalizedError("error.invalid_webhook_url")
+	}
+	if parsedURL, err := url.Parse(i.WebhookURL); err != nil || parsedURL.Host == "" {
+		return locale.NewLocalizedError("error.invalid_webhook_url")
+	}
+	return nil
+}
