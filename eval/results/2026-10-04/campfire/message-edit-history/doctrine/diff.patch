diff --git a/test/controllers/messages/edits_controller_test.rb b/test/controllers/messages/edits_controller_test.rb
new file mode 100644
index 0000000..7a7cc57
--- /dev/null
+++ b/test/controllers/messages/edits_controller_test.rb
@@ -0,0 +1,25 @@
+require "test_helper"
+
+class Messages::EditsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @message = messages(:first)
+  end
+
+  test "administrators see the original text" do
+    sign_in :david
+    @message.edits.create!(editor: users(:jason), body: "Original words")
+
+    get message_edits_url(@message)
+
+    assert_response :success
+    assert_match "Original words", response.body
+  end
+
+  test "non-administrators are forbidden" do
+    sign_in :jz
+
+    get message_edits_url(@message)
+
+    assert_response :forbidden
+  end
+end
diff --git a/test/models/message_test.rb b/test/models/message_test.rb
index 3cd12c1..679b6d2 100644
--- a/test/models/message_test.rb
+++ b/test/models/message_test.rb
@@ -27,6 +27,29 @@ class MessageTest < ActiveSupport::TestCase
     assert_equal [], message_mentioning_a_non_member.mentionees
   end
 
+  test "revising the body keeps the previous text" do
+    message = messages(:first)
+    original = message.plain_text_body
+
+    Current.set(user: users(:david)) do
+      assert_difference -> { message.edits.count }, 1 do
+        message.revise!(body: "Something new")
+      end
+    end
+
+    edit = message.edits.last
+    assert_equal original, edit.body
+    assert_equal users(:david), edit.editor
+  end
+
+  test "revising without changing the body records nothing" do
+    message = messages(:first)
+
+    assert_no_difference -> { message.edits.count } do
+      message.revise!(body: message.body.to_s)
+    end
+  end
+
   private
     def create_new_message_in(room)
       room.messages.create!(creator: users(:jason), body: "Hello", client_message_id: "123")
