diff --git a/app/views/messages/edits/index.html.erb b/app/views/messages/edits/index.html.erb
new file mode 100644
index 0000000..8812eac
--- /dev/null
+++ b/app/views/messages/edits/index.html.erb
@@ -0,0 +1,14 @@
+<h2>Edit history</h2>
+
+<% if @edits.any? %>
+  <% @edits.each do |edit| %>
+    <div class="pad-block-half border-bottom">
+      <small>
+        <strong><%= edit.editor.name %></strong> replaced this on <%= local_datetime_tag edit.created_at, style: :datetime %>
+      </small>
+      <%= simple_format h(edit.body) %>
+    </div>
+  <% end %>
+<% else %>
+  <p>This message has never been edited.</p>
+<% end %>
