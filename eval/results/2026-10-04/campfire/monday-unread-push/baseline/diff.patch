@@ -0,0 +1,49 @@
+class Push::UnreadReminder
+  MAX_NAMED_ROOMS = 3
+
+  def self.deliver_all
+    User.active.where(id: Push::Subscription.select(:user_id)).find_each do |user|
+      new(user).deliver
+    end
+  end
+
+  attr_reader :user
+
+  def initialize(user)
+    @user = user
+  end
+
+  def deliver
+    if unread_rooms.any?
+      Rails.configuration.x.web_push_pool.queue(payload, user.push_subscriptions)
+    end
+  end
+
+  private
+    def unread_rooms
+      @unread_rooms ||= user.memberships.visible.unread.includes(:room).map(&:room)
+    end
+
+    def payload
+      { title: "You have unread rooms", body: body, path: path }
+    end
+
+    def body
+      names = unread_rooms.map(&:name).sort_by(&:downcase)
+      remaining = names.size - MAX_NAMED_ROOMS
+
+      if remaining > 0
+        "#{names.first(MAX_NAMED_ROOMS).to_sentence} and #{remaining} more"
+      else
+        names.to_sentence
+      end
+    end
+
+    def path
+      if unread_rooms.one?
+        Rails.application.routes.url_helpers.room_path(unread_rooms.first)
+      else
+        Rails.application.routes.url_helpers.root_path
+      end
+    end
+end
