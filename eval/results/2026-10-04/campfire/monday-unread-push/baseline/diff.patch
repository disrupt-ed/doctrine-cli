@@ -0,0 +1,32 @@
+require "test_helper"
+
+class Push::UnreadReminderTest < ActiveSupport::TestCase
+  setup do
+    stub_web_push_dns_resolution
+    Membership.update_all(unread_at: nil)
+  end
+
+  test "sends one notification per subscription, regardless of how many rooms are unread" do
+    user = users(:kevin)
+    user.memberships.visible.limit(2).each { |membership| membership.update!(unread_at: Time.current) }
+    count = user.push_subscriptions.count
+
+    WebPush.expects(:payload_send).times(count)
+    Push::UnreadReminder.deliver_all
+    wait_for_web_push_delivery_pool_tasks(count)
+  end
+
+  test "does not notify users without unread rooms" do
+    WebPush.expects(:payload_send).never
+    Push::UnreadReminder.deliver_all
+    wait_for_web_push_delivery_pool_tasks(0)
+  end
+
+  test "ignores unread rooms the user has made invisible" do
+    memberships(:kevin_designers).update!(involvement: :invisible, unread_at: Time.current)
+
+    WebPush.expects(:payload_send).never
+    Push::UnreadReminder.new(users(:kevin)).deliver
+    wait_for_web_push_delivery_pool_tasks(0)
+  end
+end
