diff --git a/app/controllers/rooms/transcripts_controller.rb b/app/controllers/rooms/transcripts_controller.rb
new file mode 100644
index 0000000..1ba3197
--- /dev/null
+++ b/app/controllers/rooms/transcripts_controller.rb
@@ -0,0 +1,37 @@
+class Rooms::TranscriptsController < ApplicationController
+  include RoomScoped
+
+  HEADERS = %w[ id sent_at author body attachment ]
+  FORMULA_PREFIXES = %w[ = + - @ ]
+
+  def show
+    send_data transcript_csv,
+      type: "text/csv; charset=utf-8",
+      filename: "#{@room.name.to_s.parameterize.presence || "room-#{@room.id}"}-messages.csv",
+      disposition: "attachment"
+  end
+
+  private
+    def transcript_csv
+      rows = [ HEADERS ]
+
+      @room.messages.with_creator.with_attachment_details.find_each do |message|
+        rows << [
+          message.id,
+          message.created_at.utc.iso8601,
+          message.creator.name,
+          message.body.to_plain_text,
+          message.attachment? ? message.attachment.filename.to_s : nil
+        ]
+      end
+
+      "﻿" + rows.map { |row| row.map { |field| csv_field(field) }.join(",") }.join("\r\n") + "\r\n"
+    end
+
+    # Quote every field, and defuse values a spreadsheet would otherwise evaluate as formulas.
+    def csv_field(value)
+      value = value.to_s
+      value = "'#{value}" if value.start_with?(*FORMULA_PREFIXES, "\t", "\r")
+      %("#{value.gsub('"', '""')}")
+    end
+end
