diff --git a/test/controllers/rooms/transcripts_controller_test.rb b/test/controllers/rooms/transcripts_controller_test.rb
new file mode 100644
index 0000000..43c4d4c
--- /dev/null
+++ b/test/controllers/rooms/transcripts_controller_test.rb
@@ -0,0 +1,35 @@
+require "test_helper"
+
+class Rooms::TranscriptsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :david
+  end
+
+  test "member downloads the room's messages as CSV" do
+    rooms(:hq).messages.create!(creator: users(:jason), body: "Hello, \"world\"", client_message_id: "csv1")
+
+    get room_transcript_url(rooms(:hq), format: :csv)
+
+    assert_response :success
+    assert_equal "text/csv; charset=utf-8", response.content_type
+    assert_match(/attachment/, response.headers["Content-Disposition"])
+    assert_includes response.body, %("Hello, ""world""")
+    assert_includes response.body, %("#{users(:jason).name}")
+  end
+
+  test "formula-like values are neutralized" do
+    rooms(:hq).messages.create!(creator: users(:jason), body: "=1+1", client_message_id: "csv2")
+
+    get room_transcript_url(rooms(:hq), format: :csv)
+
+    assert_includes response.body, %("'=1+1")
+  end
+
+  test "non-members can't download" do
+    rooms(:hq).memberships.where(user: users(:david)).destroy_all
+
+    get room_transcript_url(rooms(:hq), format: :csv)
+
+    assert_response :not_found
+  end
+end
