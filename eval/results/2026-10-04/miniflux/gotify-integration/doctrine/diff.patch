diff --git a/internal/integration/gotify/gotify.go b/internal/integration/gotify/gotify.go
new file mode 100644
index 00000000..d4d53b83
--- /dev/null
+++ b/internal/integration/gotify/gotify.go
@@ -0,0 +1,68 @@
+// SPDX-FileCopyrightText: Copyright The Miniflux Authors. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+// Gotify API documentation: https://gotify.net/api-docs
+
+package gotify // import "miniflux.app/v2/internal/integration/gotify"
+
+import (
+	"fmt"
+	"log/slog"
+	"net/http"
+	"strings"
+
+	"miniflux.app/v2/internal/http/client"
+	"miniflux.app/v2/internal/model"
+)
+
+type Client struct {
+	serverURL string
+	token     string
+}
+
+func NewClient(serverURL, token string) *Client {
+	return &Client{serverURL: strings.TrimSuffix(serverURL, "/"), token: token}
+}
+
+func (c *Client) SendMessages(feed *model.Feed, entries model.Entries) error {
+	endpoint := c.serverURL + "/message"
+
+	for _, entry := range entries {
+		slog.Debug("Sending Gotify notification",
+			slog.String("server_url", c.serverURL),
+			slog.String("title", feed.Title),
+			slog.String("entry_url", entry.URL),
+		)
+
+		response, err := client.NewRequestBuilder(endpoint).
+			WithMethod(http.MethodPost).
+			WithHeader("X-Gotify-Key", c.token).
+			WithJSON(&gotifyMessage{
+				Title:   feed.Title,
+				Message: entry.Title,
+				Extras: map[string]any{
+					"client::notification": map[string]any{
+						"click": map[string]string{"url": entry.URL},
+					},
+				},
+			}).
+			Do()
+		if err != nil {
+			return fmt.Errorf("gotify: %w", err)
+		}
+		response.Body.Close()
+
+		if response.StatusCode >= 400 {
+			return fmt.Errorf("gotify: unable to send a notification: url=%s status=%d", endpoint, response.StatusCode)
+		}
+	}
+
+	return nil
+}
+
+// See https://gotify.net/docs/msgextras#clientnotification
+type gotifyMessage struct {
+	Title   string         `json:"title"`
+	Message string         `json:"message"`
+	Extras  map[string]any `json:"extras,omitempty"`
+}
diff --git a/internal/integration/gotify/gotify_test.go b/internal/integration/gotify/gotify_test.go
new file mode 100644
index 00000000..2d436740
--- /dev/null
+++ b/internal/integration/gotify/gotify_test.go
@@ -0,0 +1,94 @@
+// SPDX-FileCopyrightText: Copyright The Miniflux Authors. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package gotify
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"miniflux.app/v2/internal/config"
+	"miniflux.app/v2/internal/model"
+)
+
+func TestSendMessages(t *testing.T) {
+	configureIntegrationAllowPrivateNetworksOption(t)
+
+	var received []gotifyMessage
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost || r.URL.Path != "/message" {
+			t.Errorf("unexpected request: %s %s", r.Method, r.URL.Path)
+		}
+		if got := r.Header.Get("X-Gotify-Key"); got != "secret" {
+			t.Errorf("unexpected token header: %q", got)
+		}
+		if r.URL.RawQuery != "" {
+			t.Errorf("token must not be sent in the query string: %q", r.URL.RawQuery)
+		}
+
+		var message gotifyMessage
+		if err := json.NewDecoder(r.Body).Decode(&message); err != nil {
+			t.Errorf("unable to decode body: %v", err)
+		}
+		received = append(received, message)
+	}))
+	defer server.Close()
+
+	feed := &model.Feed{Title: "Example Feed"}
+	entries := model.Entries{
+		{Title: "First", URL: "https://example.org/1"},
+		{Title: "Second", URL: "https://example.org/2"},
+	}
+
+	// The trailing slash must not produce a double slash in the endpoint.
+	if err := NewClient(server.URL+"/", "secret").SendMessages(feed, entries); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	if len(received) != len(entries) {
+		t.Fatalf("expected %d messages, got %d", len(entries), len(received))
+	}
+	for i, message := range received {
+		if message.Title != feed.Title || message.Message != entries[i].Title {
+			t.Errorf("unexpected message %d: %+v", i, message)
+		}
+		click := message.Extras["client::notification"].(map[string]any)["click"].(map[string]any)
+		if click["url"] != entries[i].URL {
+			t.Errorf("unexpected click url for message %d: %v", i, click["url"])
+		}
+	}
+}
+
+func TestSendMessagesErrorStatus(t *testing.T) {
+	configureIntegrationAllowPrivateNetworksOption(t)
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusUnauthorized)
+	}))
+	defer server.Close()
+
+	entries := model.Entries{{Title: "First", URL: "https://example.org/1"}}
+	if err := NewClient(server.URL, "wrong").SendMessages(&model.Feed{}, entries); err == nil {
+		t.Fatal("expected an error for a 401 response")
+	}
+}
+
+func configureIntegrationAllowPrivateNetworksOption(t *testing.T) {
+	t.Helper()
+
+	t.Setenv("INTEGRATION_ALLOW_PRIVATE_NETWORKS", "1")
+
+	configParser := config.NewConfigParser()
+	parsedOptions, err := configParser.ParseEnvironmentVariables()
+	if err != nil {
+		t.Fatalf("Unable to configure test options: %v", err)
+	}
+
+	previousOptions := config.Opts
+	config.Opts = parsedOptions
+	t.Cleanup(func() {
+		config.Opts = previousOptions
+	})
+}
