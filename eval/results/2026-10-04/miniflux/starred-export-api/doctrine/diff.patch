+// ExportStarredEntries exports all starred entries.
+func (c *Client) ExportStarredEntries() (Entries, error) {
+	ctx, cancel := withDefaultTimeout()
+	defer cancel()
+	return c.ExportStarredEntriesContext(ctx)
+}
+
+// ExportStarredEntriesContext exports all starred entries.
+func (c *Client) ExportStarredEntriesContext(ctx context.Context) (Entries, error) {
+	body, err := c.request.Get(ctx, "/v1/export/starred")
+	if err != nil {
+		return nil, err
+	}
+	defer body.Close()
+
+	var entries Entries
+	if err := json.NewDecoder(body).Decode(&entries); err != nil {
+		return nil, fmt.Errorf("miniflux: response error (%v)", err)
+	}
+
+	return entries, nil
+}
