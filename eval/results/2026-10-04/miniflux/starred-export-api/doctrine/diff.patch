+// exportStarredEntriesHandler streams every starred entry of the user as a JSON
+// array. Entries are read page by page so memory stays bounded.
+func (h *handler) exportStarredEntriesHandler(w http.ResponseWriter, r *http.Request) {
+	userID := request.UserID(r)
+
+	fetchPage := func(beforeEntryID int64) (model.Entries, error) {
+		entries, err := h.store.NewEntryQueryBuilder(userID).
+			WithStarred(true).
+			WithSorting("id", "DESC").
+			WithLimit(model.MaxEntryLimit).
+			BeforeEntryID(beforeEntryID).
+			WithEnclosures().
+			GetEntries()
+		if err != nil {
+			return nil, err
+		}
+
+		for i := range entries {
+			entries[i].Content = mediaproxy.RewriteDocumentWithAbsoluteProxyURL(entries[i].Content)
+			entries[i].Enclosures.ProxifyEnclosureURL(config.Opts.MediaProxyMode(), config.Opts.MediaProxyResourceTypes())
+		}
+		return entries, nil
+	}
+
+	// The first page is fetched before writing headers so that a failure can
+	// still be reported as a regular error response.
+	entries, err := fetchPage(0)
+	if err != nil {
+		response.JSONServerError(w, r, err)
+		return
+	}
+
+	response.NewBuilder(w, r).
+		WithHeader("Content-Type", "application/json").
+		WithAttachment("starred-entries.json").
+		Write()
+
+	encoder := json_parser.NewEncoder(w)
+	separator := "["
+	for {
+		for i := range entries {
+			if _, err := io.WriteString(w, separator); err != nil {
+				return
+			}
+			separator = ","
+
+			if err := encoder.Encode(&entries[i]); err != nil {
+				slog.Error("Unable to write starred entries export", slog.Int64("user_id", userID), slog.Any("error", err))
+				return
+			}
+		}
+
+		if len(entries) < model.MaxEntryLimit {
+			break
+		}
+
+		entries, err = fetchPage(entries[len(entries)-1].ID)
+		if err != nil {
+			// Headers are already sent: the truncated (invalid) JSON signals the failure.
+			slog.Error("Unable to fetch starred entries for export", slog.Int64("user_id", userID), slog.Any("error", err))
+			return
+		}
+	}
+
+	if separator == "[" {
+		separator = "[]"
+	} else {
+		separator = "]"
+	}
+	io.WriteString(w, separator)
+}
