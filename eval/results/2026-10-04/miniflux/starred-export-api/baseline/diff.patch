+// exportStarredEntriesHandler streams every starred entry of the user as a JSON
+// array, reading the database in batches so memory use stays bounded.
+func (h *handler) exportStarredEntriesHandler(w http.ResponseWriter, r *http.Request) {
+	userID := request.UserID(r)
+
+	fetchBatch := func(offset int) (model.Entries, error) {
+		entries, err := h.store.NewEntryQueryBuilder(userID).
+			WithStarred(true).
+			WithSorting("id", "ASC").
+			WithOffset(offset).
+			WithLimit(model.MaxEntryLimit).
+			WithEnclosures().
+			GetEntries()
+		if err != nil {
+			return nil, err
+		}
+
+		for i := range entries {
+			entries[i].Content = mediaproxy.RewriteDocumentWithAbsoluteProxyURL(entries[i].Content)
+			entries[i].Enclosures.ProxifyEnclosureURL(config.Opts.MediaProxyMode(), config.Opts.MediaProxyResourceTypes())
+		}
+		return entries, nil
+	}
+
+	// Fetch the first batch before writing headers so a failure can still be reported as a 500.
+	entries, err := fetchBatch(0)
+	if err != nil {
+		response.JSONServerError(w, r, err)
+		return
+	}
+
+	w.Header().Set("Content-Type", "application/json")
+	w.Header().Set("Content-Disposition", `attachment; filename="starred-entries.json"`)
+	w.WriteHeader(http.StatusOK)
+
+	encoder := json_parser.NewEncoder(w)
+	_, _ = w.Write([]byte("["))
+	offset, first := 0, true
+	for len(entries) > 0 {
+		for _, entry := range entries {
+			if !first {
+				_, _ = w.Write([]byte(","))
+			}
+			first = false
+			if err := encoder.Encode(entry); err != nil {
+				return
+			}
+		}
+
+		if len(entries) < model.MaxEntryLimit {
+			break
+		}
+
+		offset += len(entries)
+		if entries, err = fetchBatch(offset); err != nil {
+			// Headers are already sent: abort so the client sees a truncated, invalid document.
+			slog.Error("Unable to export starred entries", slog.Int64("user_id", userID), slog.Any("error", err))
+			panic(http.ErrAbortHandler)
+		}
+	}
+	_, _ = w.Write([]byte("]"))
+}
