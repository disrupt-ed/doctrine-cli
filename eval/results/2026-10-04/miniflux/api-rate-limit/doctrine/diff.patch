diff --git a/internal/api/ratelimit.go b/internal/api/ratelimit.go
new file mode 100644
index 00000000..911e0b59
--- /dev/null
+++ b/internal/api/ratelimit.go
@@ -0,0 +1,51 @@
+// SPDX-FileCopyrightText: Copyright The Miniflux Authors. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package api // import "miniflux.app/v2/internal/api"
+
+import (
+	"sync"
+	"time"
+)
+
+// rateLimiter is an in-memory token bucket limiter keyed by API key.
+// The zero value is ready to use. Buckets are only created for authenticated
+// keys, so the map is bounded by the number of API keys.
+type rateLimiter struct {
+	mu      sync.Mutex
+	buckets map[string]*bucket
+}
+
+type bucket struct {
+	tokens float64
+	last   time.Time
+}
+
+// allow consumes one token for key. The bucket holds perMinute tokens and
+// refills at perMinute/60 tokens per second. When the bucket is empty it
+// returns the time to wait before the next token is available.
+func (l *rateLimiter) allow(key string, perMinute int, now time.Time) (time.Duration, bool) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+
+	if l.buckets == nil {
+		l.buckets = make(map[string]*bucket)
+	}
+
+	capacity := float64(perMinute)
+	b, ok := l.buckets[key]
+	if !ok {
+		b = &bucket{tokens: capacity, last: now}
+		l.buckets[key] = b
+	}
+
+	rate := capacity / 60
+	b.tokens = min(capacity, b.tokens+now.Sub(b.last).Seconds()*rate)
+	b.last = now
+
+	if b.tokens < 1 {
+		return time.Duration((1 - b.tokens) / rate * float64(time.Second)), false
+	}
+	b.tokens--
+	return 0, true
+}
diff --git a/internal/api/ratelimit_test.go b/internal/api/ratelimit_test.go
new file mode 100644
index 00000000..a6a3897b
--- /dev/null
+++ b/internal/api/ratelimit_test.go
@@ -0,0 +1,50 @@
+// SPDX-FileCopyrightText: Copyright The Miniflux Authors. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package api // import "miniflux.app/v2/internal/api"
+
+import (
+	"testing"
+	"time"
+)
+
+func TestRateLimiterBlocksAfterLimitAndRefills(t *testing.T) {
+	var l rateLimiter
+	now := time.Now()
+
+	for i := range 3 {
+		if _, ok := l.allow("key", 3, now); !ok {
+			t.Fatalf("request %d should be allowed", i+1)
+		}
+	}
+
+	retryAfter, ok := l.allow("key", 3, now)
+	if ok {
+		t.Fatal("fourth request should be blocked")
+	}
+	if retryAfter != 20*time.Second {
+		t.Fatalf("unexpected retry delay, got %s instead of 20s", retryAfter)
+	}
+
+	if _, ok := l.allow("key", 3, now.Add(20*time.Second)); !ok {
+		t.Fatal("request should be allowed after a token has refilled")
+	}
+	if _, ok := l.allow("key", 3, now.Add(20*time.Second)); ok {
+		t.Fatal("only one token should have refilled")
+	}
+}
+
+func TestRateLimiterKeysAreIndependent(t *testing.T) {
+	var l rateLimiter
+	now := time.Now()
+
+	if _, ok := l.allow("a", 1, now); !ok {
+		t.Fatal("first request for key a should be allowed")
+	}
+	if _, ok := l.allow("a", 1, now); ok {
+		t.Fatal("second request for key a should be blocked")
+	}
+	if _, ok := l.allow("b", 1, now); !ok {
+		t.Fatal("first request for key b should be allowed")
+	}
+}
