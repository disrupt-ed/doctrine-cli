diff --git a/internal/api/rate_limiter.go b/internal/api/rate_limiter.go
new file mode 100644
index 00000000..e82521bb
--- /dev/null
+++ b/internal/api/rate_limiter.go
@@ -0,0 +1,84 @@
+// SPDX-FileCopyrightText: Copyright The Miniflux Authors. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package api // import "miniflux.app/v2/internal/api"
+
+import (
+	"sync"
+	"time"
+)
+
+const rateLimiterCleanupInterval = time.Minute
+
+type tokenBucket struct {
+	tokens float64
+	last   time.Time
+}
+
+// rateLimiter is a token bucket rate limiter keyed by API key.
+// Each key can burst up to the configured limit and refills at limit/minute.
+type rateLimiter struct {
+	mu          sync.Mutex
+	buckets     map[string]*tokenBucket
+	lastCleanup time.Time
+	now         func() time.Time
+}
+
+func newRateLimiter() *rateLimiter {
+	return &rateLimiter{
+		buckets: make(map[string]*tokenBucket),
+		now:     time.Now,
+	}
+}
+
+// allow consumes one token for the key. When the key is over the limit,
+// it returns false and how long to wait before the next token is available.
+// A limit of zero or less disables rate limiting.
+func (l *rateLimiter) allow(key string, limitPerMinute int) (bool, time.Duration) {
+	if limitPerMinute <= 0 {
+		return true, 0
+	}
+
+	l.mu.Lock()
+	defer l.mu.Unlock()
+
+	now := l.now()
+	l.cleanup(now)
+
+	capacity := float64(limitPerMinute)
+	refillPerSecond := capacity / 60
+
+	bucket, ok := l.buckets[key]
+	if !ok {
+		bucket = &tokenBucket{tokens: capacity, last: now}
+		l.buckets[key] = bucket
+	} else {
+		elapsed := now.Sub(bucket.last).Seconds()
+		bucket.tokens = min(capacity, bucket.tokens+elapsed*refillPerSecond)
+		bucket.last = now
+	}
+
+	if bucket.tokens < 1 {
+		missing := 1 - bucket.tokens
+		return false, time.Duration(missing / refillPerSecond * float64(time.Second))
+	}
+
+	bucket.tokens--
+	return true, 0
+}
+
+// cleanup drops buckets that have been idle long enough to be full again
+// (a bucket always refills in one minute), so memory stays bounded by the
+// number of recently active keys.
+func (l *rateLimiter) cleanup(now time.Time) {
+	if now.Sub(l.lastCleanup) < rateLimiterCleanupInterval {
+		return
+	}
+	l.lastCleanup = now
+
+	for key, bucket := range l.buckets {
+		if now.Sub(bucket.last) >= time.Minute {
+			delete(l.buckets, key)
+		}
+	}
+}
diff --git a/internal/api/rate_limiter_test.go b/internal/api/rate_limiter_test.go
new file mode 100644
index 00000000..eee0aea8
--- /dev/null
+++ b/internal/api/rate_limiter_test.go
@@ -0,0 +1,86 @@
+// SPDX-FileCopyrightText: Copyright The Miniflux Authors. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package api // import "miniflux.app/v2/internal/api"
+
+import (
+	"testing"
+	"time"
+)
+
+func newTestRateLimiter() (*rateLimiter, *time.Time) {
+	now := time.Unix(1_000_000, 0)
+	l := newRateLimiter()
+	l.now = func() time.Time { return now }
+	return l, &now
+}
+
+func TestRateLimiterDisabledWhenLimitIsZero(t *testing.T) {
+	l, _ := newTestRateLimiter()
+	for range 1000 {
+		if ok, _ := l.allow("key", 0); !ok {
+			t.Fatal("expected requests to be allowed when rate limiting is disabled")
+		}
+	}
+}
+
+func TestRateLimiterRejectsAfterBurst(t *testing.T) {
+	l, _ := newTestRateLimiter()
+	for i := range 3 {
+		if ok, _ := l.allow("key", 3); !ok {
+			t.Fatalf("request %d should be allowed", i+1)
+		}
+	}
+
+	ok, retryAfter := l.allow("key", 3)
+	if ok {
+		t.Fatal("expected the fourth request to be rejected")
+	}
+	if retryAfter != 20*time.Second {
+		t.Fatalf("expected retry after 20s, got %s", retryAfter)
+	}
+}
+
+func TestRateLimiterRefillsOverTime(t *testing.T) {
+	l, now := newTestRateLimiter()
+	for range 60 {
+		l.allow("key", 60)
+	}
+	if ok, _ := l.allow("key", 60); ok {
+		t.Fatal("expected rejection once the bucket is empty")
+	}
+
+	*now = now.Add(time.Second)
+	if ok, _ := l.allow("key", 60); !ok {
+		t.Fatal("expected one token to be refilled after one second")
+	}
+	if ok, _ := l.allow("key", 60); ok {
+		t.Fatal("expected only one token to be refilled")
+	}
+}
+
+func TestRateLimiterIsPerKey(t *testing.T) {
+	l, _ := newTestRateLimiter()
+	if ok, _ := l.allow("a", 1); !ok {
+		t.Fatal("first key should be allowed")
+	}
+	if ok, _ := l.allow("a", 1); ok {
+		t.Fatal("first key should be limited")
+	}
+	if ok, _ := l.allow("b", 1); !ok {
+		t.Fatal("second key should not be affected by the first")
+	}
+}
+
+func TestRateLimiterCleansUpIdleBuckets(t *testing.T) {
+	l, now := newTestRateLimiter()
+	l.allow("a", 10)
+	l.allow("b", 10)
+
+	*now = now.Add(2 * time.Minute)
+	l.allow("c", 10)
+
+	if len(l.buckets) != 1 {
+		t.Fatalf("expected idle buckets to be removed, got %d", len(l.buckets))
+	}
+}
