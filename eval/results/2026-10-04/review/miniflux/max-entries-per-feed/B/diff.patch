diff --git a/internal/storage/entry.go b/internal/storage/entry.go
index f7f5e6f6..9c533d8e 100644
--- a/internal/storage/entry.go
+++ b/internal/storage/entry.go
@@ -365,6 +365,54 @@ func (s *Storage) RefreshFeedEntries(userID, feedID int64, entries model.Entries
 }
 
 // ArchiveEntries deletes entries older than the given interval and records tombstones so they are not re-ingested.
+// ArchiveEntriesOverFeedLimit deletes the oldest entries of each feed that has
+// more than maxEntries entries. Starred and shared entries are never deleted,
+// but they count toward the limit. Tombstones are recorded like ArchiveEntries.
+func (s *Storage) ArchiveEntriesOverFeedLimit(maxEntries, limit int) (int64, error) {
+	if maxEntries <= 0 || limit <= 0 {
+		return 0, nil
+	}
+
+	query := `
+		WITH ranked AS (
+			SELECT id, starred, share_code,
+				row_number() OVER (PARTITION BY feed_id ORDER BY published_at DESC, id DESC) AS position
+			FROM entries
+		), to_delete AS (
+			SELECT entries.id
+			FROM entries
+			JOIN ranked USING (id)
+			WHERE
+				ranked.position > $1 AND
+				ranked.starred is false AND
+				ranked.share_code=''
+			ORDER BY entries.published_at ASC, entries.id ASC
+			FOR UPDATE OF entries SKIP LOCKED
+			LIMIT $2
+		), deleted AS (
+			DELETE FROM entries
+			USING to_delete
+			WHERE entries.id = to_delete.id
+			RETURNING entries.feed_id, entries.hash
+		)
+		INSERT INTO entry_tombstones (feed_id, hash)
+		SELECT feed_id, hash FROM deleted WHERE hash <> ''
+		ON CONFLICT (feed_id, hash) DO NOTHING
+	`
+
+	result, err := s.db.Exec(query, maxEntries, limit)
+	if err != nil {
+		return 0, fmt.Errorf(`store: unable to archive entries over the feed limit: %v`, err)
+	}
+
+	count, err := result.RowsAffected()
+	if err != nil {
+		return 0, fmt.Errorf(`store: unable to get the number of rows affected: %v`, err)
+	}
+
+	return count, nil
+}
