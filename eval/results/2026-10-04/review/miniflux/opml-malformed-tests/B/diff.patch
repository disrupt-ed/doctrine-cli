+func TestParseMalformedOpmlReturnsError(t *testing.T) {
+	testCases := []struct {
+		name string
+		data string
+	}{
+		{"empty document", ``},
+		{"whitespace only", " \n\t "},
+		{"truncated document", `<?xml version="1.0"?><opml version="2.0"><body><outline text="Feed" xmlUrl="http://example.org/feed/"`},
+		{"unclosed body", `<?xml version="1.0"?><opml version="2.0"><body><outline text="Feed" xmlUrl="http://example.org/feed/"/>`},
+		{"mismatched closing tag", `<?xml version="1.0"?><opml version="2.0"><body><outline text="Feed" xmlUrl="http://example.org/feed/"/></head></opml>`},
+		{"wrong root element", `<?xml version="1.0"?><rss version="2.0"><channel><title>Not OPML</title></channel></rss>`},
+		{"invalid miniflux boolean", `<?xml version="1.0"?>
+			<opml version="2.0" xmlns:miniflux="https://miniflux.app/opml">
+				<body>
+					<outline text="Feed" xmlUrl="http://example.org/feed/" miniflux:crawler="maybe"/>
+				</body>
+			</opml>`},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			subscriptions, err := parse(bytes.NewBufferString(tc.data))
+			if err == nil {
+				t.Fatalf("Parse should generate an error, got %d subscriptions", len(subscriptions))
+			}
+
+			if subscriptions != nil {
+				t.Errorf("Subscriptions should be nil on error, got %v", subscriptions)
+			}
+		})
+	}
+}
+
+func TestParseOpmlWithoutBody(t *testing.T) {
+	data := `<?xml version="1.0"?><opml version="2.0"><head><title>Empty</title></head></opml>`
+
+	subscriptions, err := parse(bytes.NewBufferString(data))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if len(subscriptions) != 0 {
+		t.Fatalf("Wrong number of subscriptions: %d instead of %d", len(subscriptions), 0)
+	}
+}
+
+func TestParseOpmlIgnoresOutlinesWithoutFeedURL(t *testing.T) {
+	data := `<?xml version="1.0"?>
+	<opml version="2.0">
+		<body>
+			<outline text="No URL"/>
+			<outline text="Blank URL" xmlUrl="   "/>
+			<outline text="Empty Category"></outline>
+			<outline text="Valid" xmlUrl="http://example.org/feed/"/>
+		</body>
+	</opml>
+	`
+
+	subscriptions, err := parse(bytes.NewBufferString(data))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if len(subscriptions) != 1 {
+		t.Fatalf("Wrong number of subscriptions: %d instead of %d", len(subscriptions), 1)
+	}
+
+	if subscriptions[0].FeedURL != "http://example.org/feed/" {
+		t.Errorf("Unexpected feed URL: %q", subscriptions[0].FeedURL)
+	}
+}
