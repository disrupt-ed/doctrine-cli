diff --git a/internal/http/server/middleware_test.go b/internal/http/server/middleware_test.go
new file mode 100644
index 00000000..1b23b95d
--- /dev/null
+++ b/internal/http/server/middleware_test.go
@@ -0,0 +1,48 @@
+// SPDX-FileCopyrightText: Copyright The Miniflux Authors. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package server // import "miniflux.app/v2/internal/http/server"
+
+import (
+	"bytes"
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"miniflux.app/v2/internal/config"
+	"miniflux.app/v2/internal/http/request"
+)
+
+func TestMiddlewareRequestID(t *testing.T) {
+	config.Opts = config.NewOptions()
+
+	var buf bytes.Buffer
+	previous := slog.Default()
+	slog.SetDefault(slog.New(slog.NewTextHandler(&buf, nil)))
+	t.Cleanup(func() { slog.SetDefault(previous) })
+
+	var seen string
+	handler := middleware(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		seen = request.RequestID(r)
+		w.WriteHeader(http.StatusTeapot)
+	}))
+
+	r := httptest.NewRequest(http.MethodGet, "/", nil)
+	r.Header.Set("X-Request-Id", "spoofed")
+	w := httptest.NewRecorder()
+	handler.ServeHTTP(w, r)
+
+	id := w.Header().Get("X-Request-Id")
+	if id == "" || id == "spoofed" || id != seen {
+		t.Fatalf("unexpected request ID: header=%q context=%q", id, seen)
+	}
+
+	logged := buf.String()
+	for _, want := range []string{"request_id=" + id, "request.status=418"} {
+		if !strings.Contains(logged, want) {
+			t.Errorf("log line missing %q: %s", want, logged)
+		}
+	}
+}
