 	return nil
 }
 
+// ValidateWebhook ensures the webhook URL, when set, is an absolute HTTP or HTTPS URL with a host.
+func (i IntegrationForm) ValidateWebhook() *locale.LocalizedError {
+	if !i.WebhookEnabled || i.WebhookURL == "" {
+		return nil
+	}
+	if !urllib.IsAbsoluteURL(i.WebhookURL) {
+		return locale.NewLocalizedError("error.invalid_webhook_url")
+	}
+	if parsedURL, err := url.Parse(i.WebhookURL); err != nil || parsedURL.Hostname() == "" {
+		return locale.NewLocalizedError("error.invalid_webhook_url")
+	}
+	return nil
+}
+
 // NewIntegrationForm returns a new IntegrationForm.
 func NewIntegrationForm(r *http.Request) *IntegrationForm {
 	return &IntegrationForm{
diff --git a/internal/ui/form/integration_test.go b/internal/ui/form/integration_test.go
index e8d7f59b..f5fb3204 100644
--- a/internal/ui/form/integration_test.go
+++ b/internal/ui/form/integration_test.go
@@ -57,3 +57,32 @@ func TestValidateGoogleReader(t *testing.T) {
 		})
 	}
 }
+
+func TestValidateWebhook(t *testing.T) {
+	scenarios := []struct {
+		name        string
+		form        IntegrationForm
+		expectError bool
+	}{
+		{name: "disabled with invalid URL", form: IntegrationForm{WebhookURL: "nope"}},
+		{name: "enabled with empty URL", form: IntegrationForm{WebhookEnabled: true}},
+		{name: "https URL", form: IntegrationForm{WebhookEnabled: true, WebhookURL: "https://example.org/hook"}},
+		{name: "http URL with port", form: IntegrationForm{WebhookEnabled: true, WebhookURL: "http://localhost:8080/hook"}},
+		{name: "missing scheme", form: IntegrationForm{WebhookEnabled: true, WebhookURL: "example.org/hook"}, expectError: true},
+		{name: "unsupported scheme", form: IntegrationForm{WebhookEnabled: true, WebhookURL: "ftp://example.org/hook"}, expectError: true},
+		{name: "missing host", form: IntegrationForm{WebhookEnabled: true, WebhookURL: "http:///hook"}, expectError: true},
+		{name: "unparsable URL", form: IntegrationForm{WebhookEnabled: true, WebhookURL: "http://exa mple.org"}, expectError: true},
+	}
+
+	for _, scenario := range scenarios {
+		t.Run(scenario.name, func(t *testing.T) {
+			validationErr := scenario.form.ValidateWebhook()
+			if scenario.expectError && validationErr == nil {
+				t.Fatal("expected a validation error")
+			}
+			if !scenario.expectError && validationErr != nil {
+				t.Fatalf("unexpected validation error: %v", validationErr)
+			}
+		})
+	}
+}
