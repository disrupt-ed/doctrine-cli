diff --git a/internal/storage/icon_cache.go b/internal/storage/icon_cache.go
new file mode 100644
index 00000000..767aa816
--- /dev/null
+++ b/internal/storage/icon_cache.go
@@ -0,0 +1,89 @@
+// SPDX-FileCopyrightText: Copyright The Miniflux Authors. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package storage // import "miniflux.app/v2/internal/storage"
+
+import (
+	"container/list"
+	"sync"
+
+	"miniflux.app/v2/internal/model"
+)
+
+// iconCacheMaxBytes bounds the memory used by the icon cache (sum of icon contents).
+const iconCacheMaxBytes = 32 * 1024 * 1024
+
+type iconCacheEntry struct {
+	externalID string
+	icon       *model.Icon
+}
+
+// iconCache is a concurrency-safe LRU cache of icons keyed by external ID,
+// bounded by the total size of the icon contents.
+//
+// Icons are content-addressed (deduplicated by hash) and never modified once
+// stored, so entries cannot become stale; they only need to be dropped when the
+// underlying row is deleted. Cached icons are shared and must not be mutated.
+type iconCache struct {
+	mu       sync.Mutex
+	maxBytes int
+	bytes    int
+	order    *list.List // front = most recently used
+	entries  map[string]*list.Element
+}
+
+func newIconCache(maxBytes int) *iconCache {
+	return &iconCache{
+		maxBytes: maxBytes,
+		order:    list.New(),
+		entries:  make(map[string]*list.Element),
+	}
+}
+
+func (c *iconCache) get(externalID string) (*model.Icon, bool) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	element, found := c.entries[externalID]
+	if !found {
+		return nil, false
+	}
+	c.order.MoveToFront(element)
+	return element.Value.(*iconCacheEntry).icon, true
+}
+
+func (c *iconCache) set(externalID string, icon *model.Icon) {
+	size := len(icon.Content)
+	if size > c.maxBytes {
+		return
+	}
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	if element, found := c.entries[externalID]; found {
+		c.bytes -= len(element.Value.(*iconCacheEntry).icon.Content)
+		element.Value = &iconCacheEntry{externalID, icon}
+		c.order.MoveToFront(element)
+	} else {
+		c.entries[externalID] = c.order.PushFront(&iconCacheEntry{externalID, icon})
+	}
+	c.bytes += size
+
+	for c.bytes > c.maxBytes {
+		oldest := c.order.Back()
+		entry := oldest.Value.(*iconCacheEntry)
+		c.order.Remove(oldest)
+		delete(c.entries, entry.externalID)
+		c.bytes -= len(entry.icon.Content)
+	}
+}
+
+func (c *iconCache) clear() {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	c.order.Init()
+	clear(c.entries)
+	c.bytes = 0
+}
