diff --git a/app/models/room.rb b/app/models/room.rb
index 20865fc..6da7909 100644
--- a/app/models/room.rb
+++ b/app/models/room.rb
@@ -22,6 +22,8 @@ class Room < ApplicationRecord
 
   belongs_to :creator, class_name: "User", default: -> { Current.user }
 
+  normalizes :name, with: ->(name) { name.strip }
+
   validate :direct_rooms_keep_their_type, on: :update
 
   scope :opens,           -> { where(type: "Rooms::Open") }
diff --git a/test/models/room_test.rb b/test/models/room_test.rb
