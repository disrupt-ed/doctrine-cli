diff --git a/test/models/message_test.rb b/test/models/message_test.rb
index 3cd12c1..2c79e79 100644
--- a/test/models/message_test.rb
+++ b/test/models/message_test.rb
@@ -27,6 +27,16 @@ class MessageTest < ActiveSupport::TestCase
     assert_equal [], message_mentioning_a_non_member.mentionees
   end
 
+  test "body is limited to #{Message::MAX_BODY_LENGTH} characters" do
+    room = rooms(:designers)
+
+    assert room.messages.build(creator: users(:jason), body: "a" * Message::MAX_BODY_LENGTH).valid?
+
+    message = room.messages.build(creator: users(:jason), body: "a" * (Message::MAX_BODY_LENGTH + 1))
+    assert_not message.valid?
+    assert message.errors.of_kind?(:body, :too_long)
+  end
+
   private
     def create_new_message_in(room)
       room.messages.create!(creator: users(:jason), body: "Hello", client_message_id: "123")
