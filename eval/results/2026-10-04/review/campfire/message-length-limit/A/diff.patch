--- a/app/models/message.rb
+++ b/app/models/message.rb
@@ -8,6 +8,10 @@ class Message < ApplicationRecord
 
   has_rich_text :body
 
+  MAX_BODY_LENGTH = 5_000
+
+  validate :body_within_length_limit
+
   before_create -> { self.client_message_id ||= Random.uuid } # Bots don't care
   after_create_commit -> { room.receive(self) }
 
@@ -41,4 +45,11 @@ class Message < ApplicationRecord
       Sound.find_by_name match[:name]
     end
   end
+
+  private
+    def body_within_length_limit
+      if body.to_plain_text.length > MAX_BODY_LENGTH
+        errors.add :body, :too_long, count: MAX_BODY_LENGTH
+      end
+    end
 end
