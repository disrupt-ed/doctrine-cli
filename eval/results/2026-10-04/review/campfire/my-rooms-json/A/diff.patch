--- a/test/controllers/rooms_controller_test.rb
+++ b/test/controllers/rooms_controller_test.rb
@@ -10,6 +10,22 @@ class RoomsControllerTest < ActionDispatch::IntegrationTest
     assert_redirected_to room_url(users(:david).rooms.last)
   end
 
+  test "index as JSON lists the user's rooms with their unread state" do
+    user = users(:david)
+    membership = user.memberships.first
+    membership.update!(unread_at: Time.current)
+
+    get rooms_url(format: :json)
+    assert_response :success
+
+    json = JSON.parse(response.body)
+    assert_equal user.memberships.pluck(:room_id).sort, json.map { it["id"] }.sort
+
+    entry = json.find { it["id"] == membership.room_id }
+    assert_equal true, entry["unread"]
+    assert_equal user.memberships.unread.count, json.count { it["unread"] }
+  end
+
