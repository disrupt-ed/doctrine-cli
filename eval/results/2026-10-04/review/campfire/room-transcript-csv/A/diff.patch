diff --git a/test/controllers/rooms/transcripts_controller_test.rb b/test/controllers/rooms/transcripts_controller_test.rb
new file mode 100644
index 0000000..54ee683
--- /dev/null
+++ b/test/controllers/rooms/transcripts_controller_test.rb
@@ -0,0 +1,30 @@
+require "test_helper"
+
+class Rooms::TranscriptsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :david
+  end
+
+  test "member downloads the room's messages as CSV" do
+    room = rooms(:hq)
+    room.messages.create!(creator: users(:jason), body: "=HYPERLINK(\"http://example.com\")", client_message_id: "formula")
+
+    get room_transcript_url(room, format: :csv)
+
+    assert_response :success
+    assert_equal "text/csv", response.media_type
+
+    rows = CSV.parse(response.body, headers: true)
+    assert_equal %w[ sent_at author message ], rows.headers
+    assert_equal room.messages.count, rows.size
+    assert_includes rows.map { |row| row["message"] }, "'=HYPERLINK(\"http://example.com\")"
+  end
+
+  test "non-members can't download the transcript" do
+    room = Rooms::Closed.create_for({ name: "Secret" }, users: [ users(:jason) ])
+
+    get room_transcript_url(room, format: :csv)
+
+    assert_response :not_found
+  end
+end
