diff --git a/app/models/message/transcript.rb b/app/models/message/transcript.rb
new file mode 100644
index 0000000..6316339
--- /dev/null
+++ b/app/models/message/transcript.rb
@@ -0,0 +1,25 @@
+require "csv"
+
+module Message::Transcript
+  extend ActiveSupport::Concern
+
+  FORMULA_PREFIXES = %w[ = + - @ ].freeze
+
+  class_methods do
+    def to_csv
+      CSV.generate do |csv|
+        csv << %w[ sent_at author message ]
+
+        ordered.with_creator.with_attachment_details.find_each do |message|
+          csv << [ message.created_at.iso8601, message.creator.name, message.transcript_text ]
+        end
+      end
+    end
+  end
+
+  # Spreadsheets run cells starting with these characters as formulas, so defuse them.
+  def transcript_text
+    text = plain_text_body
+    text.start_with?(*FORMULA_PREFIXES, "\t", "\r") ? "'#{text}" : text
+  end
+end
