diff --git a/test/controllers/messages/edits_controller_test.rb b/test/controllers/messages/edits_controller_test.rb
new file mode 100644
index 0000000..c95dae9
--- /dev/null
+++ b/test/controllers/messages/edits_controller_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class Messages::EditsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    host! "once.campfire.test"
+
+    @room = rooms(:watercooler)
+    @message = @room.messages.ordered.first
+  end
+
+  test "updating a message keeps the original body" do
+    sign_in :david
+    original = @message.body.to_s
+
+    assert_difference -> { @message.edits.count }, +1 do
+      put room_message_url(@room, @message), params: { message: { body: "<p>Changed</p>" } }
+    end
+
+    assert_equal original, @message.edits.last.body
+    assert_equal users(:david), @message.edits.last.editor
+  end
+
+  test "updating a message without changing the body records nothing" do
+    sign_in :david
+
+    assert_no_difference -> { @message.edits.count } do
+      put room_message_url(@room, @message), params: { message: { body: @message.body.to_s } }
+    end
+  end
+
+  test "admin sees the edit history" do
+    sign_in :david
+    @message.edits.create!(body: "<p>Before</p>", editor: users(:david))
+
+    get room_message_edits_url(@room, @message)
+
+    assert_response :success
+    assert_match "Before", response.body
+  end
+
+  test "non-admin can't see the edit history" do
+    sign_in :jz
+
+    get room_message_edits_url(@room, @message)
+
+    assert_response :forbidden
+  end
+end
