diff --git a/app/views/messages/edits/index.html.erb b/app/views/messages/edits/index.html.erb
new file mode 100644
index 0000000..411eb0a
--- /dev/null
+++ b/app/views/messages/edits/index.html.erb
@@ -0,0 +1,24 @@
+<% @page_title = "Edit history" %>
+
+<div class="pad">
+  <h1>Edit history</h1>
+
+  <p><%= link_to "Back to room", room_at_message_path(@room, @message) %></p>
+
+  <h2>Current</h2>
+  <div class="message__body-content"><%= @message.body %></div>
+
+  <h2>Previous versions</h2>
+  <% if @edits.any? %>
+    <% @edits.each do |edit| %>
+      <div class="border-top pad-block">
+        <p class="txt-small">
+          Replaced by <%= edit.editor.name %> on <%= l edit.created_at, format: :long %>
+        </p>
+        <div class="message__body-content"><%= sanitize edit.body %></div>
+      </div>
+    <% end %>
+  <% else %>
+    <p>This message has not been edited.</p>
+  <% end %>
+</div>
