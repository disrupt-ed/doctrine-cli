+class Messages::EditsController < ApplicationController
+  include RoomScoped
+
+  before_action :ensure_administrator
+  before_action :set_message
+
+  def index
+    @edits = @message.edits.latest_first.includes(:editor)
+  end
+
+  private
+    def ensure_administrator
+      head :forbidden unless Current.user.administrator?
+    end
+
+    def set_message
+      @message = @room.messages.find(params[:message_id])
+    end
+end
