+require "test_helper"
+
+class Push::UnreadReminderTest < ActiveSupport::TestCase
+  setup do
+    stub_web_push_dns_resolution
+    Membership.update_all(unread_at: nil)
+  end
+
+  test "notifies users with unread rooms who have push subscriptions" do
+    memberships(:kevin_designers).update!(unread_at: Time.current)
+    memberships(:jason_designers).update!(unread_at: Time.current)
+
+    expected = users(:kevin).push_subscriptions.count + users(:jason).push_subscriptions.count
+    WebPush.expects(:payload_send).times(expected)
+
+    Push::UnreadReminder.new.push
+    wait_for_web_push_delivery_pool_tasks(expected)
+  end
+
+  test "does not notify users without unread rooms" do
+    WebPush.expects(:payload_send).never
+
+    Push::UnreadReminder.new.push
+    wait_for_web_push_delivery_pool_tasks(0)
+  end
+
+  test "ignores invisible rooms" do
+    memberships(:kevin_designers).update!(unread_at: Time.current, involvement: "invisible")
+    WebPush.expects(:payload_send).never
+
+    Push::UnreadReminder.new.push
+    wait_for_web_push_delivery_pool_tasks(0)
+  end
+end
