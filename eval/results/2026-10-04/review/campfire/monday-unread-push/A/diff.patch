@@ -0,0 +1,22 @@
+class Push::UnreadReminder
+  def push
+    unread_counts.each do |user_id, count|
+      payload = {
+        title: "Unread rooms",
+        body: "You have #{count} #{"room".pluralize(count)} with unread messages",
+        path: Rails.application.routes.url_helpers.root_path
+      }
+
+      enqueue_payload_for_delivery payload, Push::Subscription.where(user_id: user_id)
+    end
+  end
+
+  private
+    def unread_counts
+      Membership.visible.unread.where(user_id: Push::Subscription.select(:user_id)).group(:user_id).count
+    end
+
+    def enqueue_payload_for_delivery(payload, subscriptions)
+      Rails.configuration.x.web_push_pool.queue(payload, subscriptions)
+    end
+end
